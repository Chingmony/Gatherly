<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Minimal Checkstyle config — formatting is owned by Spotless/googleJavaFormat.
  These rules catch structural issues googleJavaFormat doesn't enforce.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="TreeWalker">
    <!-- Unused imports (Spotless also removes these, belt-and-suspenders) -->
    <module name="UnusedImports"/>

    <!-- No star imports -->
    <module name="AvoidStarImport"/>

    <!-- Package declaration required -->
    <module name="PackageDeclaration"/>

    <!-- No empty catch blocks without a comment -->
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignore"/>
    </module>

    <!-- No System.out/err in production code -->
    <module name="Regexp">
      <property name="format" value="System\.(out|err)\.print"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="Use a logger instead of System.out/err"/>
    </module>
  </module>
</module>
