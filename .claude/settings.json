{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$j = [Console]::In.ReadToEnd() | ConvertFrom-Json; $f = $j.tool_input.file_path; if ($f -and $f -match '\\.(ts|tsx|js|jsx)$') { npx prettier --write $f 2>$null }",
            "timeout": 30,
            "statusMessage": "Formatting frontend file..."
          }
        ]
      }
    ]
  }
}
