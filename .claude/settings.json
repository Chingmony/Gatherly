{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$json = [Console]::In.ReadToEnd() | ConvertFrom-Json; $file = $json.tool_input.file_path; if ($file -and $file -match '\\\\.(ts|tsx|js|jsx)$') { npx prettier --write $file 2>&1 | Out-Null }",
            "timeout": 30,
            "statusMessage": "Formatting frontend file..."
          }
        ]
      }
    ]
  }
}
