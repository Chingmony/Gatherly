# Frontend env (non-secret only — NEXT_PUBLIC_* is exposed to the browser, docs/12 §4).
# Browser-side API calls:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Server-side (RSC/Server Actions) calls; in docker this is the internal service URL:
INTERNAL_API_BASE_URL=http://localhost:8080/api/v1
