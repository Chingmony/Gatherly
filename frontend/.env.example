# Gatherly frontend env — copy to .env.local and adjust. See PWA-ACCESS.md.
# .env.local is gitignored; never commit personal/ephemeral values.

# How the browser reaches the backend:
#  - Set to the backend URL for DIRECT calls (requires backend CORS to allow this origin):
#      NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
#  - Leave EMPTY to route through the Next.js proxy (/api/v1 -> BACKEND_URL),
#    which avoids CORS and works behind a single ngrok tunnel (phone testing):
#      NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=http://96.9.81.187:8083/swagger-ui/index.html#

# Backend origin the server-side proxy forwards to (only used in proxy mode).
BACKEND_URL=http://96.9.81.187:8083/swagger-ui/index.html#

# Extra origins allowed to hit the dev server (comma-separated): your LAN IP
# and/or an ngrok host. Used for testing on a phone. Leave empty for local-only.
# e.g. DEV_ORIGINS=192.168.1.50,abc123.ngrok-free.dev
DEV_ORIGINS=