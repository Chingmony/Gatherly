# ───────────────────────────────────────────────────────────────────────────
# Gatherly — environment template (12-factor, see docs/12 §4).
# Copy to `.env` for local development; NEVER commit a populated `.env`.
# Production injects these from a secret manager — not from a file.
# ───────────────────────────────────────────────────────────────────────────

# ---- Database (PostgreSQL) ----
POSTGRES_DB=gatherly
POSTGRES_USER=gatherly
POSTGRES_PASSWORD=gatherly
# JDBC URL the backend uses (compose hostname `postgres`)
DB_URL=jdbc:postgresql://postgres:5432/gatherly
DB_USERNAME=gatherly
DB_PASSWORD=gatherly

# ---- Redis (OTP + rate-limit counters only) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- JWT (docs/03 §2) — generate a strong random secret; never reuse across envs ----
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# ---- Bootstrap admin seed (docs/02 §8) — credentials injected, never hard-coded ----
BOOTSTRAP_ADMIN_EMAIL=admin@gatherly.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
BOOTSTRAP_ADMIN_NAME=Gatherly Admin

# ---- SMTP / Email (OTP codes + activation invites). Local default: MailHog (docs/12 §3) ----
EMAIL_ENABLED=false
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@gatherly.local
MAIL_FROM_NAME=Gatherly
#
# To send REAL email via Gmail SMTP, set these in your local .env (never commit real secrets):
#   EMAIL_ENABLED=true
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<16-char Gmail App Password, spaces removed>   # NOT your account password
#   SMTP_AUTH=true
#   SMTP_STARTTLS=true
#   MAIL_FROM=you@gmail.com

# ---- Rustfs / S3-compatible object store. Local: MinIO ----
RUSTFS_ENDPOINT=http://minio:9000
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin
RUSTFS_BUCKET=gatherly
RUSTFS_REGION=us-east-1

# ---- Telegram ops channel (outbound-only). Disabled locally (docs/12 §3) ----
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# ---- CORS / cookies ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost

# ---- Frontend (public, non-secret only) ----
# Browser-side calls go to the public API base; server-side calls use the internal one.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
INTERNAL_API_BASE_URL=http://backend:8080/api/v1
